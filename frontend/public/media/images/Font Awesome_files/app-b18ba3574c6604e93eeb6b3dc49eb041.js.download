circle-user","circle-xmark","clipboard","clock","clone","closed-captioning","cloud","comment","comment-dots","comments","compass","copy","copyright","credit-card","envelope","envelope-open","eye","eye-slash","face-angry","face-dizzy","face-flushed","face-frown","face-frown-open","face-grimace","face-grin","face-grin-beam","face-grin-beam-sweat","face-grin-hearts","face-grin-squint","face-grin-squint-tears","face-grin-stars","face-grin-tears","face-grin-tongue","face-grin-tongue-squint","face-grin-tongue-wink","face-grin-wide","face-grin-wink","face-kiss","face-kiss-beam","face-kiss-wink-heart","face-laugh","face-laugh-beam","face-laugh-squint","face-laugh-wink","face-meh","face-meh-blank","face-rolling-eyes","face-sad-cry","face-sad-tear","face-smile","face-smile-beam","face-smile-wink","face-surprise","face-tired","file","file-audio","file-code","file-excel","file-image","file-lines","file-pdf","file-powerpoint","file-video","file-word","file-zipper","flag","floppy-disk","folder","folder-closed","folder-open","font-awesome","futbol","gem","hand","hand-back-fist","hand-lizard","hand-peace","hand-point-down","hand-point-left","hand-point-right","hand-point-up","hand-pointer","hand-scissors","hand-spock","handshake","hard-drive","headphones","heart","hospital","hourglass","hourglass-half","house","id-badge","id-card","image","images","keyboard","lemon","life-ring","lightbulb","map","message","money-bill-1","moon","newspaper","note-sticky","object-group","object-ungroup","paper-plane","paste","pen-to-square","rectangle-list","rectangle-xmark","registered","share-from-square","snowflake","square","square-caret-down","square-caret-left","square-caret-right","square-caret-up","square-check","square-full","square-minus","square-plus","star","star-half","star-half-stroke","sun","thumbs-down","thumbs-up","trash-can","truck","user","window-maximize","window-minimize","window-restore"],"style":"regular"},{"family":"classic","style":"brands"}]},{"iconPacks":["brands","classic","duotone","sharp","sharp-duotone"],"label":"Font Awesome Pro","labelIconName":"icons","labelIconPrefix":"fas","name":"pro-collection"},{"iconPacks":["brands","classic","duotone","sharp","sharp-duotone","chisel","etch","jelly","notdog","slab","thumbprint","whiteboard"],"label":"Font Awesome Pro Plus","labelIconName":"shapes","labelIconPrefix":"fas","name":"pro-plus-collection"}],"iconPacks":[{"description":"FA Brands is your go-to icon pack for when you need to showcase a company\'s logo. Whether it\'s for social media, software, or big-name products, this pack has all the icons you need to represent recognizable brands with style.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"classic","style":"brands","visualTags":[]}],"label":"Brands","labelIconName":"font-awesome","labelIconPrefix":"fab","name":"brands","sourceCanvasHeight":20,"sourceGridHeight":16},{"description":"With more icons than you can shake a stick at, FA Classic is the seasoned pro of Font Awesome. Thousands of icons in a timeless, versatile style that work just about anywhere. Classic is like the little black dress of icons.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"classic","style":"solid","visualTags":["filled","round"]},{"family":"classic","style":"regular","visualTags":["line","round"]},{"family":"classic","style":"light","visualTags":["line","round"]},{"family":"classic","style":"thin","visualTags":["line","round"]}],"label":"Classic","labelIconName":"house","labelIconPrefix":"fas","name":"classic","sourceCanvasHeight":20,"sourceGridHeight":16},{"description":"FA Duotone is double-layered companion to FA Classic, which icon-for-icon matches. These beauties bring contrast, clarity, and a little pizzazz - because when it comes to making an impact, sometimes two tones are better than one!","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"duotone","style":"solid","visualTags":["duotone","filled","round"]},{"family":"duotone","style":"regular","visualTags":["duotone","line","round"]},{"family":"duotone","style":"light","visualTags":["duotone","line","round"]},{"family":"duotone","style":"thin","visualTags":["duotone","line","round"]}],"label":"Duotone","labelIconName":"house","labelIconPrefix":"fad","name":"duotone","sourceCanvasHeight":20,"sourceGridHeight":16},{"description":"FA Sharp icons take clean lines and tight angles to the next level. Designed as a modern counterpart to our Classic icon pack, these icons slice through the clutter with razor precision for projects that need a high-definition edge.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"sharp","style":"solid","visualTags":["filled","sharp"]},{"family":"sharp","style":"regular","visualTags":["line","sharp"]},{"family":"sharp","style":"light","visualTags":["line","sharp"]},{"family":"sharp","style":"thin","visualTags":["line","sharp"]}],"label":"Sharp","labelIconName":"house","labelIconPrefix":"fass","name":"sharp","sourceCanvasHeight":20,"sourceGridHeight":16},{"description":"FA Sharp-Duotone rocks twice the tone and twice the attitude, with razor-sharp lines and layered depth for extra impact. Whether you\'re after clean, modern, or downright daring, these icons deliver. One layer is fine, but two? Now that\'s cutting-edge.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"sharp-duotone","style":"solid","visualTags":["duotone","filled","sharp"]},{"family":"sharp-duotone","style":"regular","visualTags":["duotone","line","sharp"]},{"family":"sharp-duotone","style":"light","visualTags":["duotone","line","sharp"]},{"family":"sharp-duotone","style":"thin","visualTags":["duotone","line","sharp"]}],"label":"Sharp Duotone","labelIconName":"house","labelIconPrefix":"fasds","name":"sharp-duotone","sourceCanvasHeight":20,"sourceGridHeight":16},{"description":"FA Chisel is sharp, bold, and full of character - like a sculptor\'s finest work. In this case, the sculptor is the amazing designer Laura Bohill. With its thick and thin strokes, this pack cuts through the noise and inscribes its way into the spotlight. You bring the ideas, Chisel brings the stone-cold execution.","designerName":"Laura Bohill","designerUrl":"https://laurarbee.com","familyStyles":[{"family":"chisel","style":"regular","visualTags":["line","sharp"]}],"label":"Chisel","labelIconName":"house","labelIconPrefix":"facr","name":"chisel","sourceCanvasHeight":24,"sourceGridHeight":24},{"description":"Don’t get caught with a bunch of loose icon bits ever again! Each glyph is carved from a single, glorious piece. Etch was born from a simple idea: what if you could actually create an entire set of icons from a single, connected sheet of metal? Etch’s sharp corners and rounded cutouts work together to create a big visual impact.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"etch","style":"solid","visualTags":["filled","sharp"]}],"label":"Etch","labelIconName":"house","labelIconPrefix":"faes","name":"etch","sourceCanvasHeight":24,"sourceGridHeight":20},{"description":"FA Jelly is a soft and squishy icon pack that borrows from everyone\'s favorite French mathematician, Gabriel Lamé, and his superellipse. Commonly known as \\"squircles\\", these forms help Jelly strike a sweet balance between playful curves and versatile design.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"jelly","style":"regular","visualTags":["line","round"]},{"family":"jelly-duo","style":"regular","visualTags":["duotone","line","round"]},{"family":"jelly-fill","style":"regular","visualTags":["filled","round"]}],"label":"Jelly","labelIconName":"house","labelIconPrefix":"fajr","name":"jelly","sourceCanvasHeight":24,"sourceGridHeight":20},{"description":"FA Notdog is a playful twist on classic icons, and we relish its quirky charm - not quite hotdog, not quite bun, but 100% fun. Perfect for adding a dollop of humor and personality to your designs.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"notdog","style":"solid","visualTags":["filled","round"]},{"family":"notdog-duo","style":"solid","visualTags":["duotone","filled","round"]}],"label":"Notdog","labelIconName":"house","labelIconPrefix":"fans","name":"notdog","sourceCanvasHeight":32,"sourceGridHeight":30},{"description":"What if icons could be their own buttons? FA Slab answers that question with sturdy, blocky designs that feel bold and ready for action. Equal parts dependable and playful, Slab makes a statement - because sometimes, subtlety is overrated.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"slab","style":"regular","visualTags":["line","round","dimensional"]},{"family":"slab-press","style":"regular","visualTags":["line","round"]}],"label":"Slab","labelIconName":"house","labelIconPrefix":"faslr","name":"slab","sourceCanvasHeight":32,"sourceGridHeight":30},{"description":"FA Thumbprint is a fun, friendly icon set inspired by Ed Emberley\'s thumbprint drawings that uses minimal elements to create playful, recognizable images. Add a touch of color to make them thumbthing special.","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"thumbprint","style":"light","visualTags":["duotone","line","round"]}],"label":"Thumbprint","labelIconName":"house","labelIconPrefix":"fatl","name":"thumbprint","sourceCanvasHeight":24,"sourceGridHeight":20},{"description":"FA Whiteboard is your brainstorming buddy, inspired by the creativity of a productive session on a blank canvas. These hand-drawn icons are casual and brimming with personality, delivering sketchy, inventive vibes that feel authentically human. (Because they were made by one. A human, we mean. Seriously. We promise. We have receipts.)","designerName":"Font Awesome","designerUrl":"https://fontawesome.com","familyStyles":[{"family":"whiteboard","style":"semibold","visualTags":["line","round","sketch"]}],"label":"Whiteboard","labelIconName":"house","labelIconPrefix":"fawsb","name":"whiteboard","sourceCanvasHeight":20,"sourceGridHeight":16}],"visualTags":[{"label":"Duotone","labelIconName":"circle-half","labelIconPrefix":"fad","name":"duotone"},{"label":"Filled","labelIconName":"square","labelIconPrefix":"fas","name":"filled"},{"label":"Line","labelIconName":"bars","labelIconPrefix":"fas","name":"line"},{"label":"Round","labelIconName":"circle","labelIconPrefix":"fas","name":"round"},{"label":"Sharp","labelIconName":"diamond","labelIconPrefix":"fass","name":"sharp"},{"label":"Dimensional","labelIconName":"cube","labelIconPrefix":"fas","name":"dimensional"},{"label":"Sketch","labelIconName":"scribble","labelIconPrefix":"fas","name":"sketch"}]}')},335839:(e,t)=>{"use strict";var c="discord",r=[],a="f392",i="M524.531,69.836a1.5,1.5,0,0,0-.764-.7A485.065,485.065,0,0,0,404.081,32.03a1.816,1.816,0,0,0-1.923.91,337.461,337.461,0,0,0-14.9,30.6,447.848,447.848,0,0,0-134.426,0,309.541,309.541,0,0,0-15.135-30.6,1.89,1.89,0,0,0-1.924-.91A483.689,483.689,0,0,0,116.085,69.137a1.712,1.712,0,0,0-.788.676C39.068,183.651,18.186,294.69,28.43,404.354a2.016,2.016,0,0,0,.765,1.375A487.666,487.666,0,0,0,176.02,479.918a1.9,1.9,0,0,0,2.063-.676A348.2,348.2,0,0,0,208.12,430.4a1.86,1.86,0,0,0-1.019-2.588,321.173,321.173,0,0,1-45.868-21.853,1.885,1.885,0,0,1-.185-3.126c3.082-2.309,6.166-4.711,9.109-7.137a1.819,1.819,0,0,1,1.9-.256c96.229,43.917,200.41,43.917,295.5,0a1.812,1.812,0,0,1,1.924.233c2.944,2.426,6.027,4.851,9.132,7.16a1.884,1.884,0,0,1-.162,3.126,301.407,301.407,0,0,1-45.89,21.83,1.875,1.875,0,0,0-1,2.611,391.055,391.055,0,0,0,30.014,48.815,1.864,1.864,0,0,0,2.063.7A486.048,486.048,0,0,0,610.7,405.729a1.882,1.882,0,0,0,.765-1.352C623.729,277.594,590.933,167.465,524.531,69.836ZM222.491,337.